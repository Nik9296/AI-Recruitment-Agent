# LLM
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
LLM_TEMPERATURE=0
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EMBEDDING_MODEL=models/text-embedding-004

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/recruitment

# Recruiter dashboard login (local demo only — change before any real deploy)
RECRUITER_USERNAME=recruiter
RECRUITER_PASSWORD=recruiter-review
RECRUITER_SESSION_SECRET=local-dev-session-secret

# Public recruiter/company details for outreach drafts (not credentials)
COMPANY_NAME=Demo Company
RECRUITER_DISPLAY_NAME=Demo Recruiter
RECRUITER_TITLE=Technical Recruiter
RECRUITER_CONTACT_EMAIL=recruiter@example.com

# Email (never commit real keys). Dry-run is on by default.
EMAIL_PROVIDER=ses
EMAIL_DRY_RUN=true
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=
SENDGRID_API_KEY=

# Interviews / calendar (never commit real calendar credentials)
INTERVIEW_TIMEZONE=Asia/Kolkata
INTERVIEW_DURATION_MINUTES=45
CALENDAR_DRY_RUN=true
CALENDAR_PROVIDER=none
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_CREDENTIALS_JSON=
GOOGLE_CALENDAR_CREDENTIALS_FILE=
GOOGLE_CALENDAR_SUBJECT=

# App
APP_ENV=development
DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
